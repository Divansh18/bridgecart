# Local development only. Replace with your own non-production values.
BRIDGECART_DATABASE_URL=postgresql+asyncpg://bridgecart:change-me@localhost:5432/bridgecart
BRIDGECART_LOG_LEVEL=INFO
BRIDGECART_CORS_ORIGINS=http://localhost:5173
# MCP services bind to loopback by default; expose only behind an authenticated gateway.
WOOCOMMERCE_MCP_HOST=127.0.0.1
WOOCOMMERCE_MCP_PORT=8001
INVENTORY_MCP_HOST=127.0.0.1
INVENTORY_MCP_PORT=8002
SHIPPING_MCP_HOST=127.0.0.1
SHIPPING_MCP_PORT=8003
