{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["stage", "frontend", "backend", "mcpServers", "database"],
  "properties": {
    "stage": { "enum": ["local", "production"] },
    "frontend": { "$ref": "#/definitions/image" },
    "backend": { "$ref": "#/definitions/image" },
    "mcpServers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["woocommerce", "inventory", "shipping"],
      "properties": {
        "woocommerce": { "$ref": "#/definitions/image" },
        "inventory": { "$ref": "#/definitions/image" },
        "shipping": { "$ref": "#/definitions/image" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external", "host"],
      "properties": {
        "external": { "type": "boolean" },
        "host": { "type": "string", "minLength": 1 }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": { "image": { "type": "string", "minLength": 1 } }
    }
  }
}
